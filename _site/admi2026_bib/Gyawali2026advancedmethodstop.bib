@inproceedings{Gyawali2026advancedmethodstop,
  author = {Bipul Gyawali and Saurav Aryal},
  title = {Advanced Methods for Top-View RGB-D Person Re-ID (TVRID)},
  booktitle = {Proceedings of the ADMI 2026 Symposium on Computing at Minority Institutions},
  year = {2026},
  publisher = {The Association of Computer Science Departments at Minority Institutions 2026 Symposium},
  address = {Orangeburg, SC},
  note = {Poster submission; Student - Undergraduate},
  url = {https://admiusa.github.io/2026symposium/sorted_papers/Poster/Student%20-%20Undergraduate/ADMI_2026_paper_53.pdf},
  abstract = {This paper presents a robust framework for Top-View RGB-D Person Re-Identification (TVRID), addressing the specific challenges of the ICPR 2026 competition. Our approach integrates three specialized tracks: an RGB track utilizing part-based attention and ResNet backbones (e.g., ViT, Swin) to improve robustness to occlusion; a Depth track focusing on body-shape cues learned from 1-channel depth with attention and metric losses; and a Cross-Modal track employing dual-stream fusion with optional cross-attention and cross-modal metric losses. By combining identity (ArcFace) and metric (batch-hard triplet, center) losses within a PyTorch Lightning framework, our method achieves strong discriminability across same-camera and cross-passage scenarios.}
}
