@inproceedings{Mendoza2026investigatingmotionfocus,
  author = {Carlos Sac Mendoza and Lily Liang and Briana Wellman},
  title = {Investigating Motion-Focused Video Frame Interpolation: Efficiency vs. Fidelity},
  booktitle = {Proceedings of the ADMI 2026 Symposium on Computing at Minority Institutions},
  year = {2026},
  publisher = {The Association of Computer Science Departments at Minority Institutions 2026 Symposium},
  address = {Orangeburg, SC},
  note = {Full-Oral submission; Student - Graduate},
  url = {https://admiusa.github.io/2026symposium/sorted_papers/Full-Oral/Student%20-%20Graduate/ADMI_2026_paper_23.pdf},
  abstract = {A significant challenge in Video Frame Interpolation (VFI) is reducing the processing time without significantly sacrificing visual quality. To address it, we developed a computationally efficient motion-focused VFI methodology, based on Google's FILM (Frame Interpolation for Large Motion) model. Our proposed approach, Motion-focused FILM, selectively interpolates only the most dynamic areas of the video to reduce the computational load and processing time. We also implemented a tensor bucketing strategy to reduce computational overhead. We evaluated our approach on the DAVIS 2017 dataset. The results show a 95% reduction in processing time compared to the full-frame method. It achieved a Peak Signal-to-Noise Ratio (PSNR) score that was approximately 88% of the baseline, indicating a discernible loss in pixel-level fidelity. However, it retained over 87% of the structural similarity (SSIM) test, suggesting that the overall structure of the interpolated image remains mostly intact. We also investigated the impact of video resolution on our approach's performance.}
}
