  author = {Xiqiang Zheng},
  title = {Some experimental results for fingerprint image processing},
  booktitle = {Proceedings of the ADMI 2026 Symposium on Computing at Minority Institutions},
  year = {2026},
  publisher = {The Association of Computer Science Departments at Minority Institutions 2026 Symposium},
  address = {Orangeburg, SC},
  note = {Full-Oral submission; Faculty},
  url = {https://admiusa.github.io/2026symposium/sorted_papers/Full-Oral/Faculty/ADMI_2026_paper_27.pdf},
  abstract = {Fingerprints offer a reliable and unique means of identification and hence are crucial in fields such as law enforcement and personal identification. However, fingerprint images are hardly of good quality. They may be corrupted and degraded with elements of noise owing to many issues including deviations in skin and impression circumstances. We test some commonly available fingerprint image processing codes and show some experimental results to see the progress and challenges of fingerprint image enhancement, segmentation and minutiae extraction.}
}
