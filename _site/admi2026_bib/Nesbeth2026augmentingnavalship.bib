@inproceedings{Nesbeth2026augmentingnavalship,
  author = {Clemson Nesbeth and Saurav Keshari Aryal and Gloria Washington and Jaye Nias and Christopher Watson and Janelle Yankey},
  title = {Augmenting Naval Ship Images for Viewing Distance using Adobe Generative Fill},
  booktitle = {Proceedings of the ADMI 2026 Symposium on Computing at Minority Institutions},
  year = {2026},
  publisher = {The Association of Computer Science Departments at Minority Institutions 2026 Symposium},
  address = {Orangeburg, SC},
  note = {Poster submission; Student - Undergraduate},
  url = {https://admiusa.github.io/2026symposium/sorted_papers/Poster/Student%20-%20Undergraduate/ADMI_2026_paper_52.pdf},
  abstract = {The aim of this project is to assess the ability of a generative AI to produce reasonable and believable images based on the same original images at varying scales to simulate differences in distance from the object. The objects used in this project were varying types of ships. The generated images were assessed in three different ways, all on a scale of high medium and low to measure levels of quality. Firstly, background quality which refers to the realism and consistency of the generated image. Subject dimensions which refers to how well the generated image preserves the scale and zoom of the ship in the original image. And subject integrity, which referred to the features of the ship and how consistent and believable they were. Additionally, we noted whether the original image contained the ship as a whole without any ‘cut off’ parts, and if so, being labelled as “Incomplete source”. And lastly was “Artifact present” which stated if the generated image had had hallucinations or objects added that were not present in the original image. Space was also made for comments to be made on the generated images.}
}
