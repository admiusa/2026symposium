  author = {Luther Gourdine and Alejandro Fountain and Blayne Montaque and Brandon Williams and Bipul Gyawali and Somkenechukwu Onwusika and Kroix Jones and Kwaku Asare and Saurav Aryal},
  title = {A.N.T.S. (Autonomous, Navigation, Technician, Swarm)},
  booktitle = {Proceedings of the ADMI 2026 Symposium on Computing at Minority Institutions},
  year = {2026},
  publisher = {The Association of Computer Science Departments at Minority Institutions 2026 Symposium},
